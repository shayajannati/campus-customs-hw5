# Copy this file to ".env" in the repository root and fill in your own values.
# ".env" is listed in .gitignore and must never be committed. Do not put real secrets in this file.

# Portkey API key used by the five agents (model: gpt-6-luna). Needed only to run the agents live.
PORTKEY_API_KEY=your-portkey-api-key-here

# Admin token for the protected backend routes (run a ticket, approve a payment, reset the database).
# Choose any long random string of at least 16 characters, for example: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CAMPUS_ADMIN_TOKEN=choose-a-long-random-secret-of-at-least-16-characters
